<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/focus_fill" /><stroke android:width="2dp" android:color="@color/brand" /><corners android:radius="40dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/focus_fill" /><corners android:radius="40dp" /></shape></item>
    <item><shape><solid android:color="@color/fill" /><corners android:radius="40dp" /></shape></item>
</selector>
