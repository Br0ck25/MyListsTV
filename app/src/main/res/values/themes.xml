<resources>
    <!-- Framework theme on purpose: no AppCompat, no Material, no Compose on Home (1 GB rules). -->
    <style name="Theme.MyListsTV" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorControlActivated">@color/brand</item>
        <item name="android:alertDialogTheme">@style/Theme.MyListsTV.Dialog</item>
    </style>
    <!-- Every system dialog and menu: dark rounded card, white text, a white ring on a soft fill around the row or button under the focus, never a solid block. -->
    <style name="Theme.MyListsTV.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:textColorAlertDialogListItem">@color/text</item>
        <item name="android:colorAccent">@color/text</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/dialog_item</item>
        <item name="android:selectableItemBackground">@drawable/dialog_item</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/DialogButton</item>
        <item name="android:windowMinWidthMajor">40%</item>
        <item name="android:windowMinWidthMinor">40%</item>
    </style>
    <!-- The right-hand panel (SidePanel): a transparent window that only dims what is behind it; the panel draws itself. -->
    <style name="Theme.MyListsTV.Panel" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
    </style>
    <!-- An activity shown as a centred modal over the page behind it. -->
    <style name="Theme.MyListsTV.Modal" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>
    <style name="DialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/dialog_button</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
